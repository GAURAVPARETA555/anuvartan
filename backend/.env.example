# Django Configuration
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:8081

# Database Configuration
# Production (Render PostgreSQL):
#   DATABASE_URL is set automatically by Render — do not set it locally for prod.
# Local development — leave unset to use SQLite fallback, or set a local postgres URL:
# DATABASE_URL=postgres://user:password@localhost:5432/anuvartan_db

# AI Integration
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
